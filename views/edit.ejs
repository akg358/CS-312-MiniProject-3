<!DOCTYPE html>
<html>
<head>
    <title>Edit</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="wrap">
        <h1>Edit Post</h1>

        <form action="/edit/<%= post.blog_id %>" method="POST" class="card">
            <input type="text" name="postTitle" value="<%= post.title %>" required>

            <textarea name="postBody" rows="4" required><%= post.body %></textarea>

            <button>Save</button>
            <a href="/">Cancel</a>
        </form>
    </div>
</body>
</html>
